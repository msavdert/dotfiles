# =============================================================================
# op run --env-file target: AI tooling
# =============================================================================
# Contains ONLY op:// references. No secret value ever appears in this file, so
# it is safe to commit. `op run --env-file=ai.env -- claude` resolves every
# reference in ONE request and injects the results into that single process.
#
# Used by the claude() / kilocode() wrappers in configs/zsh/.zshrc.
# Requires OP_SERVICE_ACCOUNT_TOKEN (devbox) or an unlocked 1Password app (mac).
#
# Migration note: when 1Password Environments leaves beta this whole file is
# replaced by `op run --environment ai`. See docs/05-secrets.md.
# =============================================================================

ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=op://dotfiles/OpenRouter/generaltoken
ANTHROPIC_MODEL=moonshotai/kimi-k2.6
OPENROUTER_API_KEY=op://dotfiles/OpenRouter/generaltoken
GEMINI_API_KEY=op://dotfiles/Google/gemini-cli-token
