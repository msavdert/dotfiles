# =============================================================================
# op run --env-file target: GitHub
# =============================================================================
# Only needed for non-interactive git/gh usage (CI-style scripts inside the
# devbox). Interactive `gh` and `git push` normally authenticate through
# `gh auth git-credential`, configured in configs/git/config - no token in the
# environment at all.
#
# Usage:  opwith git gh repo list
# =============================================================================

GH_TOKEN=op://dotfiles/GitHub/admintoken
GITHUB_TOKEN=op://dotfiles/GitHub/admintoken
