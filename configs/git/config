# =============================================================================
# Git configuration - shared by macOS and the devbox container
# =============================================================================
# Machine-specific settings (commit signing keys, credential helpers that only
# exist on one platform) go in ~/.gitconfig.local, which is included at the
# BOTTOM of this file so it wins.
# =============================================================================

[user]
    name = msavdert
    # Keeps the real address out of every public commit. Override in
    # ~/.gitconfig.local if a particular machine needs something else.
    email = msavdert@users.noreply.github.com

[init]
    defaultBranch = main

[github]
    user = msavdert

[protocol]
    allow = always

# --- Credentials -------------------------------------------------------------
# HTTPS remotes authenticate straight from 1Password (op://dotfiles/GitHub/
# admintoken), not through `gh auth login`'s OAuth session. That session lives
# in ~/.config/gh/hosts.yml on ONE machine and does not exist in fresh devbox
# rebuilds, ephemeral containers, or non-interactive AI-agent shells (they
# don't source ~/.zshrc, so the `opwith` wrapper isn't available either). A
# helper that resolves the token itself needs nothing pre-set - it works the
# same in an interactive shell, this devbox, or any headless agent process.
# The empty first `helper` resets any helper inherited from a system config.
[credential "https://github.com"]
    helper =
    helper = "!f() { test \"$1\" = get && printf 'username=x-access-token\\npassword=%s\\n' \"$(op read op://dotfiles/GitHub/admintoken)\"; }; f"
[credential "https://gist.github.com"]
    helper =
    helper = "!f() { test \"$1\" = get && printf 'username=x-access-token\\npassword=%s\\n' \"$(op read op://dotfiles/GitHub/admintoken)\"; }; f"

# --- Transfer ----------------------------------------------------------------
[http]
    postBuffer = 52428800

[core]
    compression = 0

# --- Quality of life ---------------------------------------------------------
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[diff]
    algorithm = histogram
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
[column]
    ui = auto
[branch]
    sort = -committerdate

# --- delta (present in the devbox image) -------------------------------------
# If delta is not installed, git falls back to the default pager.
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true

# --- Machine-specific overrides ----------------------------------------------
# Last include wins. Holds commit signing (1Password op-ssh-sign on macOS) and
# anything else that is not portable between the laptop and the container.
[include]
    path = ~/.gitconfig.local
