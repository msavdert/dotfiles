[user]
    email = github@savdert.com
    name = msavdert
[init]
    defaultBranch = main
[github]
    user = msavdert
[protocol]
    allow = always
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
